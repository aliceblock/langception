{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Langception",
  "version": "0.1.0",
  "identifier": "app.langception",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "results",
        "title": "Langception — Results",
        "width": 560,
        "height": 720,
        "minWidth": 360,
        "minHeight": 320,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
